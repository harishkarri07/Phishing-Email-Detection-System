# Environment Configuration Example
# Copy or rename to .env for local production testing

# --- Server Port Configuration ---
# Express Server Port (Dynamically set by hosting platforms like Heroku/Render/Cloud Run)
PORT=3000

# --- Express Backend -> Python FastAPI Backend URL ---
# URL where Express will proxy ML requests.
# Development: http://localhost:8000
# Production: https://<your-deployed-python-backend>.onrender.com
ML_API_URL=http://localhost:8000

# --- Frontend -> API Proxy / Backend URL ---
# Base URL for frontend API calls.
# Development: /api (proxied by Express) or http://localhost:8000
# Production: /api or https://<your-deployed-app>.onrender.com/api
VITE_API_URL=/api

# --- FastAPI CORS Allowed Origins ---
# Allowed frontend domain for CORS security in FastAPI.
# Set to your deployed frontend origin in production (e.g., https://my-phishing-app.onrender.com)
FRONTEND_URL=http://localhost:3000
